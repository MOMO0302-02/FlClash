<?xml version="1.0" encoding="utf-8"?>
<!--
  应用标记：Clash Party 的主图标。

  设计说明：
  - 紫红色渐变背景（从紫色到粉红色）
  - 白色猫头剪影（简洁造型，圆形头部 + 两个三角耳朵）
  - 108dp 画布，72dp 安全区域内绘制主要内容
  - 适配 Android 自适应图标（圆形、方形、圆角方形等）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 渐变背景：紫红渐变 -->
    <path
        android:fillColor="#8B5CF6"
        android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#8B5CF6"
                android:endColor="#EC4899" />
        </aapt:attr>
    </path>

    <!-- 白色猫头剪影 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 40,42
            L 36,36
            L 40,36
            C 40,36 38,40 40,42
            Z

            M 68,42
            L 72,36
            L 68,36
            C 68,36 70,40 68,42
            Z

            M 54,38
            C 44,38 36,46 36,56
            C 36,66 44,74 54,74
            C 64,74 72,66 72,56
            C 72,46 64,38 54,38
            Z" />
</vector>
